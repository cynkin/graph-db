# Copy to .env.local and fill in.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Any long random string, e.g. output of:  npx auth secret   or   openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# SQLite file for login credentials (default: data/app.db)
# SQLITE_PATH=data/app.db

# Comma-separated emails that get the admin role when they register
ADMIN_EMAILS=

# Default admin account, created on first run (defaults: admin@gmail.com / admin123)
# DEFAULT_ADMIN_EMAIL=admin@gmail.com
# DEFAULT_ADMIN_PASSWORD=admin123
