# Copy to deploy/.env on the server and fill in.

# Your domain, with its DNS A record pointing at this server. No https://, no trailing slash.
DOMAIN=graphnet.example.com

# Choose a strong password (8+ characters). Used only inside Docker.
NEO4J_PASSWORD=change-me-to-something-long

# Long random string. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=you@example.com

# Admin account created on first start (defaults: admin@gmail.com / admin123).
# Set your own password here for a public site.
# DEFAULT_ADMIN_EMAIL=admin@gmail.com
# DEFAULT_ADMIN_PASSWORD=admin123
